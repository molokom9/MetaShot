--- !u!114 &942535482
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 942535478}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3a6d2696c3c7e0d4d96b8fb5367efc4c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  spriteSleep: {fileID: 21300000, guid: f56de634e0ed6f341aa21bc3cd746938, type: 3}
  spriteAwake: {fileID: 21300000, guid: 0f4fcbce10318984a927a7853379cc8d, type: 3}
  spriteBark: {fileID: 21300000, guid: b0b2b40fa9100964582a5dbb19132f42, type: 3}
  dogImage: {fileID: 942535480}
  pressScale: 0.9
  pressAnimDuration: 0.08
  barkCooldown: 2.2
  barkAudioSource: {fileID: 0}
  barkClips: []
  pitchMin: 0.85
  pitchMax: 1.15
  barksInSeriesMin: 2
  barksInSeriesMax: 3
  barkGapMin: 0.18
  barkGapMax: 0.32
  barkSpriteDuration: 0.4
  advicePanel: {fileID: 1957947915}
  adviceText: {fileID: 1092062463}
  adviceShowDuration: 6
  advices:
  - "\u0433\u0430\u0432-\u0433\u0430\u0432"
  - "\u0433\u0430\u0432-\u0433\u0430\u0432 \u044F \u0441\u043E\u0431\u0430\u043A\u0430"
  - "\u0441\u043E\u0431\u0430\u043A\u0430 \u0434\u0435\u043B\u0430\u0435\u0442 \u0433\u0430\u0432-\u0433\u0430\u0432"
  - "\u0437\u043E\u0432\u0438 \u043C\u0435\u043D\u044F \u0433\u0443\u043B\u044F\u0448"
  - "\u0431\u0435\u0433\u0430\u0442\u044C \u043D\u0430 wasd, \u0430 \u0434\u0430\u043B\u044C\u0448\u0435
    \u0441\u0430\u043C"
  - "\u043D\u0430\u0436\u043C\u0438 \u0443\u0436\u0435 \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
    \u0438\u0433\u0440\u0430\u0442\u044C"
  - "\u0441\u043E\u0432\u0435\u0442: \u043E\u0431\u043D\u044E\u0445\u0438\u0432\u0430\u0439
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0443\u0433\u043E\u043B, \u0442\u0430\u043C
    \u043C\u043D\u043E\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0442\u043D\u043E\u0433\u043E"
  - "\u0434\u0432\u0438\u0433\u0430\u0439\u0441\u044F \u0431\u043E\u043B\u044C\u0448\u0435,
    \u0442\u0430\u043A \u0441\u043B\u043E\u0436\u043D\u0435\u0435 \u0443\u043C\u0435\u0440\u0435\u0442\u044C"
  - "\u0445\u0440\u0430\u043D\u0438 \u0441\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435"
  - "\u0438\u0433\u0440\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u044C\u0441\u044F
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F"
  - "\u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0439 \u0443\u0433\u043B\u044B, \u0442\u0430\u043C
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0438\u0434\u044F\u0442 \u0433\u043E\u043F\u043D\u0438\u043A\u0438"
  - "\u0442\u044B \u0436\u0435 \u0437\u043D\u0430\u0435\u0448\u044C \u043F\u0440\u043E
    \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0433\u043E\u043F\u043D\u0438\u043A\u043E\u0432
    \u0441 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430\u043C\u0438 \u0438
    \u0442\u043E \u0447\u0442\u043E \u043E\u043D\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
    \u0442\u0435\u0431\u044F \u0443\u0431\u044C\u044E\u0442?"
  - "\u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0443\u043C\u0435\u0435\u0442
    \u0432\u044B\u0431\u0438\u0432\u0430\u0442\u044C \u0434\u0432\u0435\u0440\u0438 "
  - "\u0447\u0435\u043C \u0434\u0430\u043B\u044C\u0448\u0435 \u0442\u044B \u0441\u0442\u043E\u0438\u0448\u044C
    \u043E\u0442 \u0432\u0440\u0430\u0433\u0430 \u0442\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435
    \u043F\u043E \u0442\u0435\u0431\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442"
  - "\u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0438\u0433\u0440\u044B \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
    \u043D\u0430\u043F\u0440\u0430\u0432\u043E"
  - "\u043D\u0430 MAP 5 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
    \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435"
  - "\u0432 \u0438\u0433\u0440\u0435 \u0430\u0436 6 \u043E\u0440\u0443\u0436\u0438\u0439!"
  - "\u0432 \u0438\u0433\u0440\u0435 \u043C\u043E\u0433 \u0431\u044B\u0442\u044C
    \u043A\u0438\u0431\u0435\u0440-\u043B\u0435\u043D\u0438\u043D, \u043D\u043E \u0435\u0431\u043B\u0430\u043D
    \u043E\u0434\u0443\u043C\u0430\u043B\u0441\u044F"
  - "\u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0430 MetaShot \u043D\u0430\u0447\u0430\u043B\u0441\u044C
    05.10.2026"
  - "\u0432\u0440\u0430\u0433\u0438 \u043C\u043E\u0433\u0443\u0442 \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C
    \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430"
  - "\u0432\u0440\u0430\u0433\u0438 \u0443\u043C\u043D\u0435\u0435 \u0447\u0435\u043C
    \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C!"
  - "\u0432\u0440\u0430\u0433\u0438 \u0438 \u043F\u0440\u0430\u0432\u0434\u0430 \u043C\u043E\u0433\u0443\u0442
    \u0443\u0431\u0438\u0442\u044C \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430"
  - "\u0438\u0433\u0440\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u043B\u0430
    \u043D\u0430\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F AshShooter 3D"
  - "MetaShot \u043F\u0435\u0440\u0432\u0430\u044F \u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u0438\u0433\u0440\u0430 Qwile Software"
  - "\u043D\u0430 \u043C\u043D\u043E\u0433\u0438\u0445 \u043B\u043E\u043A\u0430\u0446\u0438\u044F\u0445
    \u0435\u0441\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u044B!"
  - "\u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u0447\u0442\u043E \u043F\u043E\u0441\u043B\u0435
    \u0432\u0442\u043E\u0440\u0433\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0438\u0433\u0440\u044B \u0431\u0443\u0434\u0435\u0442 \u043F\u0440\u0438\u043A\u043E\u043B"
  - "\u043D\u0435 \u043E\u0431\u044C\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u0441\u0435\u0445 \u0443\u0431\u0438\u0432\u0430\u0442\u044C"
  - "\u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433 \u043C\u043E\u0436\u0435\u0442
    \u043D\u0430\u0447\u0430\u0442\u044C \u0443\u0431\u0435\u0433\u0430\u0442\u044C
    \u0435\u0441\u043B\u0438 \u043E\u043D \u043F\u043E\u0447\u0442\u0438 \u0443\u0431\u0438\u0442"
  - "\u0432\u0440\u0430\u0433\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u044B\u0442\u0430\u044E\u0442\u044C\u0441\u044F
    \u043F\u0440\u0435\u0434\u0443\u0433\u0430\u0434\u0430\u0442\u044C \u0442\u0432\u043E\u0438
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F"
  - "\u0440\u0435\u0432\u043E\u043B\u044C\u0432\u0435\u0440 \u0438\u043C\u0435\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B!"
  - "\u0432\u043E\u0442 \u0447\u0435\u043B\u043B\u0435\u043D\u0434\u0436 \u0442\u0435\u0431\u0435:
    \u043F\u0440\u043E\u0439\u0442\u0438 \u0438\u0433\u0440\u0443 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0441 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C"
  - "\u043A\u0430\u043A \u0442\u044B \u0434\u0443\u043C\u0430\u0435\u0448\u044C,
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043B\u0438 \u0442\u044B
    \u0432\u0441\u0435 \u0434\u0435\u043B\u0430\u0435\u0448\u044C? \u0438 \u043A
    \u0447\u0435\u043C\u0443 \u043F\u0440\u0438\u0432\u0435\u0434\u0443\u0442 \u0442\u0432\u043E\u0438
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F"
  - "\u0438\u0433\u0440\u0430 \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0442\u044C\u0441\u044F!"
  - "\u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u0432 \u0438\u0433\u0440\u0430\u0445
    \u043D\u0435 \u0441\u044E\u0436\u0435\u0442, \u0430 \u0433\u0435\u0439\u043C\u043F\u043B\u0435\u0439"
  - "\u043D\u0430\u0440\u043A\u043E\u043C\u0430\u043D\u044B \u0441\u0430\u043C\u044B\u0435
    \u0441\u043B\u0430\u0431\u044B\u0435 \u0432 \u0438\u0433\u0440\u0435"
  - "\u0433\u043E\u043F\u043D\u0438\u043A \u0441 \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u043E\u043C
    \u0441\u0430\u043C\u044B\u0439 \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u0432
    \u0438\u0433\u0440\u0435, \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C \u0435\u0433\u043E
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E \u0441\u043B\u043E\u0436\u043D\u043E\u0432\u0430\u0442\u043E"
  - "\u0431\u0443\u0434\u044C \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C,
    \u0432\u0440\u0430\u0433\u0438 \u043C\u043E\u0433\u0443\u0442 \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F,
    \u0438 \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0440\u043E\u0448\u043E"
  - "\u0432 \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044C \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u043E\u0435
    \u043E\u0440\u0443\u0436\u0438\u0435"
  - "\u0432\u044B\u0431\u0438\u0432\u0430\u0439 \u0434\u0432\u0435\u0440\u0438 \u0441
    \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430,
    \u0442\u0430\u043A \u043C\u043E\u0436\u043D\u043E \u0441\u043B\u0443\u0447\u0430\u0439\u043E
    \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043F\u043E \u043B\u0438\u0446\u0443"
  - "\u043F\u0440\u043E\u0439\u0442\u0438 \u0438\u0433\u0440\u0443 \u0441 \u043E\u0434\u043D\u0438\u043C
    \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C \u0432\u043F\u043E\u043B\u043D\u0435
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E!"
  - "\u043D\u043E\u0433\u043E\u0439 \u043C\u043E\u0436\u043D\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
    \u0432\u044B\u0431\u0438\u0432\u0430\u0442\u044C \u0434\u0432\u0435\u0440\u0438,
    \u0430 \u0438 \u0447\u0435\u043B\u044E\u0441\u0442\u044C"
  - "\u0432\u0440\u0430\u0433\u0438 \u043D\u0435 \u0431\u0443\u0434\u0443\u0442 \u0431\u0435\u0436\u0430\u0442\u044C
    \u0437\u0430 \u0442\u043E\u0431\u043E\u0439 \u0432\u0435\u0447\u043D\u043E\u0441\u0442\u044C,
    \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043F\u0440\u043E\u0441\u0442\u0443
    \u0437\u0430\u0431\u0438\u0442\u044C \u043D\u0430 \u0442\u0435\u0431\u044F"
  - "\u0437\u0430\u0439\u0434\u0438 \u0432 \u043C\u0435\u043D\u044E \u0438 \u043D\u0430\u0436\u043C\u0438
    \u043A\u043B\u0430\u0432\u0438\u0448\u0443 F10, \u0442\u044B \u0441\u0430\u043C
    \u043F\u043E\u0439\u043C\u0435\u0448\u044C \u0447\u0442\u043E \u043E\u043D\u0430
    \u0434\u0435\u043B\u0430\u0435\u0442"
  spamResetTime: 1
  spamClickThreshold: 8
  specialPhrases:
  - "\u043D\u0443 \u0447\u0435 \u0442\u044B \u0449\u0435\u043B\u043A\u0430\u0435\u0448\u044C
