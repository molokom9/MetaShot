--- !u!114 &1844822815
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1844822810}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a82103e674a20b4399ec25844dea394, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  mainPanel: {fileID: 0}
  continueButton: {fileID: 1427914801}
  newGameButton: {fileID: 385545024}
  creditsButton: {fileID: 94363873}
  quitButton: {fileID: 1895509634}
  linkButtons:
  - button: {fileID: 1186610728}
    url: 'https://qwile-gamess.itch.io '
  - button: {fileID: 1001312857}
    url: https://t.me/metashotmods
  continueButtonText: {fileID: 1951539845}
  disabledTextColor: {r: 0.5, g: 0.5, b: 0.5, a: 1}
  gameSceneName: GAME!
  confirmPanel: {fileID: 2129720056}
  confirmNewGameMessage: Are you sure you want to start a new game?
  confirmQuitMessage: Are you sure you want to quit the game?
  creditsText: "Lead Developers \u2013 Molokom9\r\nGame Designer \u2013 Molokom9\r\n\r\nTESTING\r\nLead
    Tester \u2013 uswer1106"
  confirmText: {fileID: 2039235437}
  confirmYesButton: {fileID: 32071466}
  confirmNoButton: {fileID: 193794876}
  confirmCloseButton: {fileID: 2132860541}
  gammaPrefsKey: GammaValue
  gammaSlider: {fileID: 0}
  applyGammaOnStart: 1
  showCursor: 1
  resetTimeScale: 1
  introPanel: {fileID: 953502986}
  introText: {fileID: 658917544}
  pressAnyKeyText: {fileID: 611485610}
  introExtraObject: {fileID: 1609558722}
  introTextRU: "1955. Moscow. I'm standing in a gateway with a Belomor pistol in
    my mouth, looking at my Hero of the USSR medal. In '45, when my commander fled
    like a rat, I held the tower alone and boiled leather belts in the mud for a
    week to keep from starving to death. I returned a war-cripple, with a hole in
    my side and a completely shattered psyche. The doctors at the hospital are writing
    about \"fits of uncontrollable rage.\" Morons. I'm completely calm. I'm just
    so fed up with the idiots around me.\n\nBut most of all, I'm fed up with this
    bald idiot. The whole country has turned into a madhouse: millions of idiots
    jerk off to portraits of Lenin, eat shit from shovels, and sing hymns about \"bright
    communism.\" They didn't build a paradise, but a giant meat-packing plant where
    people are ground up for the sake of the nonsense that all this sectarian rabble
    believes. I'm sick of their slogans, these red lies, and these bastards who look
    into the mouths of corpses.\n\nI'm not going to save anyone\u2014these people
    are happy to remove the boot that's crushing them. I have no higher purpose;
    I simply came to shorten the leader's head. I shat on this shit-stained idol
    and then ran away from the Kremlin to his secret boulevard closet, but you can't
    fool me\u2014I've got a lead, my tactics have been rethought. I've soldered off
    my gold star, loaded my shotgun, and am heading straight for his reception. I'll
    shove Ilyich's communism right down his bald, terrifying throat, and anyone who
    gets in my way will be smashed to a pulp. Let's go, bitch."
  introTextEN: "1955 \u0433\u043E\u0434. \u041C\u043E\u0441\u043A\u0432\u0430. \u042F
    \u0441\u0442\u043E\u044E \u0432 \u043F\u043E\u0434\u0432\u043E\u0440\u043E\u0442\u043D\u0435
    \u0441 \xAB\u0411\u0435\u043B\u043E\u043C\u043E\u0440\u043E\u043C\xBB \u0432
    \u0437\u0443\u0431\u0430\u0445 \u0438 \u0441\u043C\u043E\u0442\u0440\u044E \u043D\u0430
    \u0441\u0432\u043E\u044E \u043C\u0435\u0434\u0430\u043B\u044C \u0413\u0435\u0440\u043E\u044F
    \u0421\u0421\u0421\u0420. \u0412 \u0441\u043E\u0440\u043E\u043A \u043F\u044F\u0442\u043E\u043C,
    \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
    \u0441\u0431\u0435\u0436\u0430\u043B \u043A\u0430\u043A \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
    \u043A\u0440\u044B\u0441\u0430, \u044F \u043E\u0434\u0438\u043D \u0443\u0434\u0435\u0440\u0436\u0430\u043B
    \u0432\u044B\u0448\u043A\u0443 \u0438 \u043D\u0435\u0434\u0435\u043B\u044E \u0432\u0430\u0440\u0438\u043B
    \u043A\u043E\u0436\u0430\u043D\u044B\u0435 \u0440\u0435\u043C\u043D\u0438 \u0432
    \u0433\u0440\u044F\u0437\u0438, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0441\u0434\u043E\u0445\u043D\u0443\u0442\u044C
    \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430. \u042F \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
    \u0441 \u0432\u043E\u0439\u043D\u044B \u043A\u0430\u043B\u0435\u043A\u043E\u0439,
    \u0441 \u0434\u044B\u0440\u043E\u0439 \u0432 \u0431\u043E\u043A\u0443 \u0438
    \u0441 \u043D\u0430\u0433\u043B\u0443\u0445\u043E \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u043E\u0439
    \u043F\u0441\u0438\u0445\u0438\u043A\u043E\u0439. \u0412\u0440\u0430\u0447\u0438
    \u0432 \u0433\u043E\u0441\u043F\u0438\u0442\u0430\u043B\u0435 \u043F\u0438\u0448\u0443\u0442
    \u043F\u0440\u043E \xAB\u043F\u0440\u0438\u0441\u0442\u0443\u043F\u044B \u043D\u0435\u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u043E\u0433\u043E
    \u0433\u043D\u0435\u0432\u0430\xBB. \u0414\u0435\u0431\u0438\u043B\u044B. \u042F
    \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0435\u043D.
    \u041F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u043D\u044F \u0434\u043E \u0441\u0443\u0434\u043E\u0440\u043E\u0433
    \u0437\u0430\u0435\u0431\u0430\u043B\u0438 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0435
    \u0434\u043E\u043B\u0431\u043E\u0435\u0431\u044B.\r\n\r\n\u041D\u043E \u0431\u043E\u043B\u044C\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E \u043C\u0435\u043D\u044F \u0437\u0430\u0435\u0431\u0430\u043B
    \u044D\u0442\u043E\u0442 \u043B\u044B\u0441\u044B\u0439 \u0438\u0441\u0442\u0443\u043A\u0430\u043D.
    \u0412\u0441\u044F \u0441\u0442\u0440\u0430\u043D\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C
    \u0432 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0439 \u0434\u043E\u043C:
    \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u044B \u0431\u0430\u0440\u0430\u043D\u043E\u0432
    \u0434\u0440\u043E\u0447\u0430\u0442 \u043D\u0430 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u044B
    \u041B\u0435\u043D\u0438\u043D\u0430, \u0436\u0440\u0443\u0442 \u0434\u0435\u0440\u044C\u043C\u043E
    \u0441 \u043B\u043E\u043F\u0430\u0442\u044B \u0438 \u043F\u043E\u044E\u0442 \u0433\u0438\u043C\u043D\u044B
    \u043F\u0440\u043E \xAB\u0441\u0432\u0435\u0442\u043B\u044B\u0439 \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u0437\u043C\xBB.
    \u041E\u043D\u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u043D\u0435
    \u0440\u0430\u0439, \u0430 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0439
    \u043C\u044F\u0441\u043E\u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0442, \u0433\u0434\u0435
    \u043B\u044E\u0434\u0435\u0439 \u043F\u0435\u0440\u0435\u043C\u0430\u043B\u044B\u0432\u0430\u044E\u0442
    \u0440\u0430\u0434\u0438 \u0447\u0443\u0448\u0438, \u0432 \u043A\u043E\u0442\u043E\u0440\u0443\u044E
    \u0432\u0435\u0440\u0438\u0442 \u0432\u0435\u0441\u044C \u044D\u0442\u043E\u0442
    \u0441\u0435\u043A\u0442\u0430\u043D\u0442\u0441\u043A\u0438\u0439 \u0441\u0431\u0440\u043E\u0434.
    \u041C\u0435\u043D\u044F \u0442\u043E\u0448\u043D\u0438\u0442 \u043E\u0442 \u0438\u0445
    \u043B\u043E\u0437\u0443\u043D\u0433\u043E\u0432, \u043E\u0442 \u044D\u0442\u043E\u0439
    \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u043B\u0436\u0438 \u0438 \u043E\u0442
    \u0443\u0431\u043B\u044E\u0434\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442 \u0442\u0440\u0443\u043F\u0443
    \u0432 \u0440\u043E\u0442.\r\n\r\n\u042F \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0441\u044C
    \u043D\u0438\u043A\u043E\u0433\u043E \u0441\u043F\u0430\u0441\u0430\u0442\u044C
    \u2014 \u044D\u0442\u043E\u0442 \u043D\u0430\u0440\u043E\u0434 \u0441\u0430\u043C
    \u0440\u0430\u0434 \u043B\u0438\u0437\u0430\u0442\u044C \u0441\u0430\u043F\u043E\u0433,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0435\u0433\u043E \u0434\u0430\u0432\u0438\u0442.
    \u0423 \u043C\u0435\u043D\u044F \u043D\u0435\u0442 \u0432\u044B\u0441\u0448\u0435\u0439
    \u0446\u0435\u043B\u0438, \u044F \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0438\u0448\u0435\u043B
    \u0443\u043A\u043E\u0440\u043E\u0442\u0438\u0442\u044C \u0432\u043E\u0436\u0434\u044F
    \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443. \u042D\u0442\u043E\u0442 \u0441\u0446\u0430\u043D\u044B\u0439
    \u0438\u0434\u043E\u043B\u0438\u0449\u0435 \u043F\u0435\u0440\u0435\u0441\u0440\u0430\u043B
    \u0438 \u0441\u0432\u0430\u043B\u0438\u043B \u0438\u0437 \u041A\u0440\u0435\u043C\u043B\u044F
    \u0432 \u0441\u0432\u043E\u0439 \u0442\u0430\u0439\u043D\u044B\u0439 \u0431\u0443\u043D\u043A\u0435\u0440-\u043A\u0430\u0431\u0438\u043D\u0435\u0442,
    \u043D\u043E \u043C\u0435\u043D\u044F \u043D\u0435 \u043D\u0430\u0435\u0431\u0435\u0448\u044C
    \u2014 \u043D\u0430\u0432\u043E\u0434\u043A\u0430 \u0435\u0441\u0442\u044C, \u0442\u0430\u043A\u0442\u0438\u043A\u0430
    \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0435\u043D\u0430. \u042F \u043E\u0442\u043F\u0430\u044F\u043B
    \u0437\u043E\u043B\u043E\u0442\u0443\u044E \u0437\u0432\u0435\u0437\u0434\u0443,
    \u0437\u0430\u0440\u044F\u0434\u0438\u043B \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A
    \u0438 \u0438\u0434\u0443 \u043F\u0440\u044F\u043C\u0438\u043A\u043E\u043C \u043A
    \u043D\u0435\u043C\u0443 \u043D\u0430 \u043F\u0440\u0438\u0435\u043C. \u042F
    \u0437\u0430\u0441\u0443\u043D\u0443 \u0418\u043B\u044C\u0438\u0447\u0443 \u0435\u0433\u043E
    \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u0437\u043C \u043F\u0440\u044F\u043C\u043E
    \u0432 \u043B\u044B\u0441\u0443\u044E \u0436\u0443\u0442\u043A\u0443\u044E \u0433\u043B\u043E\u0442\u043A\u0443,
    \u0430 \u043B\u044E\u0431\u043E\u0433\u043E, \u043A\u0442\u043E \u0432\u0441\u0442\u0430\u043D\u0435\u0442
    \u043D\u0430 \u043F\u0443\u0442\u0438, \u0441 \u043F\u043E\u0442\u0440\u043E\u0445\u0430\u043C\u0438
    \u0440\u0430\u0437\u043C\u0430\u0436\u0443 \u043F\u043E \u0441\u0442\u0435\u043D\u0430\u043C.
    \u041F\u043E\u0433\u043D\u0430\u043B\u0438, \u0441\u0443\u043A\u0430."
  languageToggleButton: {fileID: 1242746224}
  languageToggleLabel: {fileID: 0}
