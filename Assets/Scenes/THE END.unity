  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0432\u0447\u0430\u0440\u043A\u0430 \u0413\u0443\u043B\u044F\u0448.\r\n\u0422\u0432\u043E\u0439
    \u0432\u0435\u0440\u043D\u044B\u0439 \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u043D\u043E\u0433\u0438\u0439
    \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A \u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u0441\u0432\u0435\u0442\u043B\u0430\u044F \u043F\u0430\u043C\u044F\u0442\u044C
    \u0438\u0437 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u0436\u0438\u0437\u043D\u0438.
    \u0413\u0443\u043B\u044F\u0448 \u0431\u044B\u043B \u0441\u0430\u043C\u044B\u043C
    \u043F\u0440\u0435\u0434\u0430\u043D\u043D\u044B\u043C \u043F\u0441\u043E\u043C:
    \u0432 \u043C\u0438\u0440\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u0431\u043E\u0436\u0430\u043B
    \u0434\u0440\u044B\u0445\u043D\u0443\u0442\u044C \u0431\u0435\u0437 \u0437\u0430\u0434\u043D\u0438\u0445
    \u043B\u0430\u043F, \u0430 \u043D\u0430 \u0444\u0440\u043E\u043D\u0442\u0435
    \u0434\u0435\u043B\u0438\u043B \u0441 \u0442\u043E\u0431\u043E\u0439 \u043A\u0430\u0436\u0434\u044B\u0439
    \u043E\u043A\u043E\u043F \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
    \u043F\u0430\u0439\u043A\u0443. \u041F\u043E\u0433\u0438\u0431 \u0432 \u0431\u043E\u044E,
    \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u0432\u043E\u0435\u0432\u0430\u043B"
  m_isRightToLeft: 0
